# Invalid placeholders on purpose. Never commit .env or paste secrets into chat.
PUBLIC_BASE_URL=https://mail-mcp.example.com
EMAIL_ADDRESS=owner@example.com
EMAIL_AUTH_CODE=REPLACE_WITH_YOUR_QQ_APP_AUTHORIZATION_CODE
# Generate a separate high-entropy secret; do NOT reuse the QQ app code.
OWNER_PASSWORD=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET
# Exact canonical callback URL shown by YOUR MCP client. No wildcard or HTTP.
ALLOWED_REDIRECT_URIS=https://client.example.com/oauth/callback
# Only needed if a browser client sends another Origin. Comma-separated HTTPS origins.
ALLOWED_ORIGINS=
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
ENABLE_WRITE_TOOLS=false
ENABLE_DELETE_TOOL=false
